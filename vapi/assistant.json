{
  "name": "Northside Intake - Riley",
  "firstMessageMode": "assistant-speaks-first-with-model-generated-message",
  "model": {
    "provider": "anthropic",
    "model": "claude-sonnet-5",
    "temperature": 0.4,
    "maxTokens": 300,
    "messages": [
      {
        "role": "system",
        "content": "__SYSTEM_PROMPT__"
      }
    ],
    "tools": [
      {
        "type": "function",
        "async": false,
        "function": {
          "name": "start_call",
          "description": "Call this once, immediately, before greeting the caller. Returns whether this caller has an interrupted registration to resume, whether they are already a patient, and which field to ask for first.",
          "parameters": { "type": "object", "properties": {} }
        },
        "server": { "url": "__BASE_URL__/voice/start", "timeoutSeconds": 20 }
      },
      {
        "type": "function",
        "async": false,
        "function": {
          "name": "capture_fields",
          "description": "Save one or more fields the caller just gave you. Call this after every answer - do not batch up answers until the end. Returns which fields were accepted, which were rejected with a re-prompt to speak, and which field to ask for next.",
          "parameters": {
            "type": "object",
            "properties": {
              "fields": {
                "type": "object",
                "description": "Map of field name to value. Only include fields the caller actually gave you.",
                "properties": {
                  "first_name": { "type": "string" },
                  "last_name": { "type": "string" },
                  "date_of_birth": { "type": "string", "description": "MM/DD/YYYY or YYYY-MM-DD" },
                  "sex": { "type": "string", "description": "Male, Female, Other, or Decline to Answer" },
                  "phone_number": { "type": "string", "description": "10-digit US number, any format" },
                  "email": { "type": "string" },
                  "address_line_1": { "type": "string" },
                  "address_line_2": { "type": "string" },
                  "city": { "type": "string" },
                  "state": { "type": "string", "description": "2-letter abbreviation or full state name" },
                  "zip_code": { "type": "string" },
                  "insurance_provider": { "type": "string" },
                  "insurance_member_id": { "type": "string" },
                  "preferred_language": { "type": "string" },
                  "emergency_contact_name": { "type": "string" },
                  "emergency_contact_phone": { "type": "string" }
                }
              }
            },
            "required": ["fields"]
          }
        },
        "server": { "url": "__BASE_URL__/voice/capture", "timeoutSeconds": 20 }
      },
      {
        "type": "function",
        "async": false,
        "function": {
          "name": "get_confirmation",
          "description": "Call when all required fields are collected. Returns the read-back script broken into short chunks. Read each chunk as its own sentence with a pause between, then ask the caller to confirm.",
          "parameters": { "type": "object", "properties": {} }
        },
        "server": { "url": "__BASE_URL__/voice/confirm", "timeoutSeconds": 20 }
      },
      {
        "type": "function",
        "async": false,
        "function": {
          "name": "restart_registration",
          "description": "Call only if the caller explicitly asks to start over. Clears everything collected so far.",
          "parameters": { "type": "object", "properties": {} }
        },
        "server": { "url": "__BASE_URL__/voice/restart", "timeoutSeconds": 20 }
      },
      {
        "type": "function",
        "async": false,
        "function": {
          "name": "save_registration",
          "description": "Call only after the caller has confirmed the read-back. Saves the record. Returns status created, updated, already_saved, incomplete, or error - tell the caller what actually happened.",
          "parameters": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["auto", "create", "update"],
                "description": "Leave as auto unless the caller explicitly chose to create a new record."
              }
            }
          }
        },
        "server": { "url": "__BASE_URL__/voice/finalize", "timeoutSeconds": 30 }
      }
    ]
  },
  "voice": {
    "provider": "11labs",
    "voiceId": "sarah",
    "stability": 0.5,
    "similarityBoost": 0.75,
    "speed": 1.0
  },
  "transcriber": {
    "provider": "deepgram",
    "model": "nova-3",
    "language": "en-US",
    "numerals": true
  },
  "server": { "url": "__BASE_URL__/voice/event" },
  "serverMessages": ["end-of-call-report", "status-update"],
  "silenceTimeoutSeconds": 20,
  "maxDurationSeconds": 900,
  "backgroundSound": "office",
  "startSpeakingPlan": {
    "waitSeconds": 0.4,
    "smartEndpointingEnabled": true
  },
  "stopSpeakingPlan": {
    "numWords": 2,
    "voiceSeconds": 0.2,
    "backoffSeconds": 1.0
  },
  "endCallFunctionEnabled": true,
  "endCallPhrases": ["goodbye", "have a great day", "take care"],
  "analysisPlan": {
    "summaryPrompt": "Summarise this patient registration call in two sentences: what was collected and how it ended."
  }
}
