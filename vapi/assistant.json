{
  "name": "CloudCare Clinic Intake",
  "firstMessageMode": "assistant-speaks-first",
  "model": {
    "provider": "anthropic",
    "model": "claude-sonnet-5",
    "temperature": 0.4,
    "maxTokens": 300,
    "messages": [
      {
        "role": "system",
        "content": "__SYSTEM_PROMPT__"
      }
    ],
    "tools": [
      {
        "type": "function",
        "async": false,
        "function": {
          "name": "start_call",
          "description": "Call this once, immediately, before greeting the caller. Returns whether this caller has an interrupted registration to resume, whether they are already a patient, and which field to ask for first.",
          "parameters": {
            "type": "object",
            "properties": {}
          }
        },
        "server": {
          "url": "__BASE_URL__/voice/start",
          "timeoutSeconds": 20
        }
      },
      {
        "type": "function",
        "async": false,
        "function": {
          "name": "lookup_patient",
          "description": "Check whether a phone number already belongs to a registered patient. Use when the caller gives a number different from the one they are calling from.",
          "parameters": {
            "type": "object",
            "properties": {
              "phone_number": {
                "type": "string",
                "description": "10-digit US phone number, any format"
              }
            },
            "required": [
              "phone_number"
            ]
          }
        },
        "server": {
          "url": "__BASE_URL__/voice/lookup",
          "timeoutSeconds": 20
        },
        "messages": [
          {
            "type": "request-start",
            "blocking": false,
            "contents": [
              {
                "type": "text",
                "language": "en",
                "text": "Let me check that."
              },
              {
                "type": "text",
                "language": "en",
                "text": "Let me have a look."
              }
            ]
          }
        ]
      },
      {
        "type": "function",
        "async": false,
        "function": {
          "name": "capture_fields",
          "description": "Save one or more fields the caller just gave you. Call this after every answer - do not batch up answers until the end. Returns which fields were accepted, which were rejected with a re-prompt to speak, and which field to ask for next.",
          "parameters": {
            "type": "object",
            "properties": {
              "fields": {
                "type": "object",
                "description": "Map of field name to value. Only include fields the caller actually gave you.",
                "properties": {
                  "first_name": {
                    "type": "string"
                  },
                  "last_name": {
                    "type": "string"
                  },
                  "date_of_birth": {
                    "type": "string",
                    "description": "MM/DD/YYYY or YYYY-MM-DD"
                  },
                  "sex": {
                    "type": "string",
                    "description": "Male, Female, Other, or Decline to Answer"
                  },
                  "phone_number": {
                    "type": "string",
                    "description": "10-digit US number, any format"
                  },
                  "email": {
                    "type": "string"
                  },
                  "address_line_1": {
                    "type": "string"
                  },
                  "address_line_2": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string",
                    "description": "2-letter abbreviation or full state name"
                  },
                  "zip_code": {
                    "type": "string"
                  },
                  "insurance_provider": {
                    "type": "string"
                  },
                  "insurance_member_id": {
                    "type": "string"
                  },
                  "preferred_language": {
                    "type": "string"
                  },
                  "emergency_contact_name": {
                    "type": "string"
                  },
                  "emergency_contact_phone": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "fields"
            ]
          }
        },
        "server": {
          "url": "__BASE_URL__/voice/capture",
          "timeoutSeconds": 20
        },
        "messages": [
          {
            "type": "request-start",
            "blocking": false,
            "contents": [
              {
                "type": "text",
                "language": "en",
                "text": "Okay."
              },
              {
                "type": "text",
                "language": "en",
                "text": "Right."
              },
              {
                "type": "text",
                "language": "en",
                "text": "Sure."
              },
              {
                "type": "text",
                "language": "en",
                "text": "Thank you."
              },
              {
                "type": "text",
                "language": "en",
                "text": "Of course."
              },
              {
                "type": "text",
                "language": "en",
                "text": "Certainly."
              }
            ]
          },
          {
            "type": "request-response-delayed",
            "timingMilliseconds": 2200,
            "contents": [
              {
                "type": "text",
                "language": "en",
                "text": "Just a moment."
              }
            ]
          }
        ]
      },
      {
        "type": "function",
        "async": false,
        "function": {
          "name": "get_confirmation",
          "description": "Call when all required fields are collected. Returns the read-back script broken into short chunks. Read each chunk as its own sentence with a pause between, then ask the caller to confirm.",
          "parameters": {
            "type": "object",
            "properties": {}
          }
        },
        "server": {
          "url": "__BASE_URL__/voice/confirm",
          "timeoutSeconds": 20
        },
        "messages": [
          {
            "type": "request-start",
            "blocking": false,
            "contents": [
              {
                "type": "text",
                "language": "en",
                "text": "Okay, let me go over what I have."
              },
              {
                "type": "text",
                "language": "en",
                "text": "Let me read this back so you can check it."
              },
              {
                "type": "text",
                "language": "en",
                "text": "Right, here's what I've got."
              }
            ]
          }
        ]
      },
      {
        "type": "function",
        "async": false,
        "function": {
          "name": "restart_registration",
          "description": "Call only if the caller explicitly asks to start over. Clears everything collected so far.",
          "parameters": {
            "type": "object",
            "properties": {}
          }
        },
        "server": {
          "url": "__BASE_URL__/voice/restart",
          "timeoutSeconds": 20
        },
        "messages": [
          {
            "type": "request-start",
            "contents": [
              {
                "type": "text",
                "language": "en",
                "text": "No problem, starting fresh."
              },
              {
                "type": "text",
                "language": "en",
                "text": "Sure, let's start over."
              }
            ],
            "blocking": false
          }
        ]
      },
      {
        "type": "function",
        "async": false,
        "function": {
          "name": "save_registration",
          "description": "Call only after the caller has confirmed the read-back. Saves the record. Returns status created, updated, already_saved, incomplete, or error - tell the caller what actually happened.",
          "parameters": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "auto",
                  "create",
                  "update"
                ],
                "description": "Leave as auto unless the caller explicitly chose to create a new record."
              }
            }
          }
        },
        "server": {
          "url": "__BASE_URL__/voice/finalize",
          "timeoutSeconds": 30
        },
        "messages": [
          {
            "type": "request-start",
            "blocking": false,
            "contents": [
              {
                "type": "text",
                "language": "en",
                "text": "Okay, let me get this saved for you."
              },
              {
                "type": "text",
                "language": "en",
                "text": "Putting that through now."
              },
              {
                "type": "text",
                "language": "en",
                "text": "Getting that saved."
              }
            ]
          },
          {
            "type": "request-response-delayed",
            "timingMilliseconds": 2500,
            "contents": [
              {
                "type": "text",
                "language": "en",
                "text": "Still going - one moment."
              }
            ]
          }
        ]
      }
    ]
  },
  "voice": {
    "provider": "11labs",
    "voiceId": "sarah",
    "stability": 0.5,
    "similarityBoost": 0.75,
    "speed": 0.95
  },
  "transcriber": {
    "provider": "deepgram",
    "model": "nova-3",
    "language": "en-US",
    "numerals": true,
    "keywords": [
      "Aetna:2",
      "Cigna:2",
      "Humana:2",
      "Kaiser:2",
      "Medicaid:2",
      "Medicare:2",
      "UnitedHealthcare:2",
      "Anthem:2",
      "Centene:2",
      "Molina:2",
      "Tricare:2",
      "BlueCross:2",
      "BlueShield:2"
    ]
  },
  "server": {
    "url": "__BASE_URL__/voice/event"
  },
  "serverMessages": [
    "end-of-call-report",
    "status-update"
  ],
  "silenceTimeoutSeconds": 45,
  "maxDurationSeconds": 900,
  "backgroundSound": "office",
  "startSpeakingPlan": {
    "waitSeconds": 0.4,
    "smartEndpointingEnabled": true
  },
  "stopSpeakingPlan": {
    "numWords": 2,
    "voiceSeconds": 0.2,
    "backoffSeconds": 1.0
  },
  "endCallFunctionEnabled": true,
  "endCallPhrases": [
    "goodbye",
    "have a great day",
    "take care"
  ],
  "analysisPlan": {
    "summaryPrompt": "Summarise this patient registration call in two sentences: what was collected and how it ended.",
    "successEvaluationPrompt": "Did the caller complete registration and did the agent confirm a successful save? Answer true or false.",
    "successEvaluationRubric": "PassFail"
  },
  "firstMessage": "Thanks for calling CloudCare Clinic, this is Shiwani. I can get you registered as a new patient - it takes about two minutes. Is now a good time?",
  "artifactPlan": {
    "recordingEnabled": true,
    "transcriptPlan": {
      "enabled": true
    }
  },
  "backgroundDenoisingEnabled": true,
  "voicemailDetection": {
    "provider": "vapi",
    "backoffPlan": {
      "maxRetries": 1
    }
  },
  "messagePlan": {
    "idleMessages": [
      "Take your time - whenever you're ready.",
      "Are you still there?",
      "Whenever you're ready, I just need that next detail."
    ],
    "idleTimeoutSeconds": 10,
    "idleMessageMaxSpokenCount": 3,
    "idleMessageResetCountOnUserSpeechEnabled": true,
    "silenceTimeoutMessage": "I can't hear anything on the line, so I'll let you go for now. Everything you've given me is saved - just call us back when it suits. Take care."
  }
}
