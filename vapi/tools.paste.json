[
  {
    "type": "function",
    "function": {
      "name": "start_call",
      "description": "Call this once, immediately, before greeting the caller. Returns whether this caller has an interrupted registration to resume, whether they are already a patient, and which field to ask for first.",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    "server": {
      "url": "<YOUR_BASE_URL>/voice/start",
      "timeoutSeconds": 20,
      "headers": {
        "X-Vapi-Secret": "<YOUR_VAPI_SERVER_SECRET>"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "lookup_patient",
      "description": "Check whether a phone number already belongs to a registered patient. Use when the caller gives a number different from the one they are calling from.",
      "parameters": {
        "type": "object",
        "properties": {
          "phone_number": {
            "type": "string",
            "description": "10-digit US phone number, any format"
          }
        },
        "required": [
          "phone_number"
        ]
      }
    },
    "server": {
      "url": "<YOUR_BASE_URL>/voice/lookup",
      "timeoutSeconds": 20,
      "headers": {
        "X-Vapi-Secret": "<YOUR_VAPI_SERVER_SECRET>"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "capture_fields",
      "description": "Save one or more fields the caller just gave you. Call this after every answer - do not batch up answers until the end. Returns which fields were accepted, which were rejected with a re-prompt to speak, and which field to ask for next.",
      "parameters": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "object",
            "description": "Map of field name to value. Only include fields the caller actually gave you.",
            "properties": {
              "first_name": {
                "type": "string"
              },
              "last_name": {
                "type": "string"
              },
              "date_of_birth": {
                "type": "string",
                "description": "MM/DD/YYYY or YYYY-MM-DD"
              },
              "sex": {
                "type": "string",
                "description": "Male, Female, Other, or Decline to Answer"
              },
              "phone_number": {
                "type": "string",
                "description": "10-digit US number, any format"
              },
              "email": {
                "type": "string"
              },
              "address_line_1": {
                "type": "string"
              },
              "address_line_2": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "description": "2-letter abbreviation or full state name"
              },
              "zip_code": {
                "type": "string"
              },
              "insurance_provider": {
                "type": "string"
              },
              "insurance_member_id": {
                "type": "string"
              },
              "preferred_language": {
                "type": "string"
              },
              "emergency_contact_name": {
                "type": "string"
              },
              "emergency_contact_phone": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "fields"
        ]
      }
    },
    "server": {
      "url": "<YOUR_BASE_URL>/voice/capture",
      "timeoutSeconds": 20,
      "headers": {
        "X-Vapi-Secret": "<YOUR_VAPI_SERVER_SECRET>"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_confirmation",
      "description": "Call when all required fields are collected. Returns the read-back script broken into short chunks. Read each chunk as its own sentence with a pause between, then ask the caller to confirm.",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    "server": {
      "url": "<YOUR_BASE_URL>/voice/confirm",
      "timeoutSeconds": 20,
      "headers": {
        "X-Vapi-Secret": "<YOUR_VAPI_SERVER_SECRET>"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "restart_registration",
      "description": "Call only if the caller explicitly asks to start over. Clears everything collected so far.",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    "server": {
      "url": "<YOUR_BASE_URL>/voice/restart",
      "timeoutSeconds": 20,
      "headers": {
        "X-Vapi-Secret": "<YOUR_VAPI_SERVER_SECRET>"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "save_registration",
      "description": "Call only after the caller has confirmed the read-back. Saves the record. Returns status created, updated, already_saved, incomplete, or error - tell the caller what actually happened.",
      "parameters": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "auto",
              "create",
              "update"
            ],
            "description": "Leave as auto unless the caller explicitly chose to create a new record."
          }
        }
      }
    },
    "server": {
      "url": "<YOUR_BASE_URL>/voice/finalize",
      "timeoutSeconds": 30,
      "headers": {
        "X-Vapi-Secret": "<YOUR_VAPI_SERVER_SECRET>"
      }
    }
  }
]
