# Postgres connection string (Supabase / Neon / any managed Postgres).
# Supabase: Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Shared secret sent by Vapi as the X-Vapi-Secret header on every tool call.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
VAPI_SERVER_SECRET=

# Vapi private API key, used only by vapi/provision.py to create the assistant.
VAPI_API_KEY=

# Public base URL of this service, e.g. https://your-app.onrender.com
PUBLIC_BASE_URL=

LOG_LEVEL=INFO
